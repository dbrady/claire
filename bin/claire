#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "optimist"
require "claire"

SUBCOMMANDS = %w[init check log report edit].freeze

global_opts = Optimist.options do
  banner <<~BANNER
    claire - Clarity time tracker CLI

    Usage:
      claire <subcommand> [options]

    Subcommands:
      init    Bootstrap config from ~/.claude/.mcp.json
      check   Resolve a ticket/PR/code and print the project code
      log     Resolve and record a billable time entry
      report  Show weekly hours by project code
      edit    Open the time log in $EDITOR

    Options:
  BANNER
  opt :version, "Print version and exit", short: :none
  stop_on SUBCOMMANDS
end

if global_opts[:version]
  puts "claire #{Claire::VERSION}"
  exit 0
end

subcommand = ARGV.shift

case subcommand
when "init"
  require "claire/cli/init"
  Claire::CLI::Init.new.run
when "check"
  require "claire/cli/check"
  subopts = Optimist.options do
    opt :refresh, "Bypass cache, re-resolve, and rewrite cached entries", short: "-r", default: false
  end
  input = ARGV.shift
  if input.nil? || input.empty?
    warn "Usage: claire check [--refresh] <ticket|url|project-code>"
    exit 1
  end
  Claire::CLI::Check.new.run(input, refresh: subopts[:refresh])
when "log"
  require "claire/cli/log"
  subopts = Optimist.options do
    opt :on,      "Date worked on (YYYY-MM-DD, today, yesterday, weekday, M/D)", type: :string, short: "-O"
    opt :note,    "Free-text note", type: :string, short: "-m"
    opt :refresh, "Bypass resolver cache", short: "-r", default: false
  end
  target = ARGV.shift
  duration = ARGV.shift
  if target.nil? || target.empty? || duration.nil? || duration.empty?
    warn "Usage: claire log <target> <duration> [--on DATE] [--note STR]"
    exit 1
  end
  Claire::CLI::Log.new.run(target, duration, on: subopts[:on], note: subopts[:note], refresh: subopts[:refresh])
when "report", "edit"
  warn "claire: '#{subcommand}' is not yet implemented"
  exit 1
when nil
  Optimist.educate
else
  warn "claire: unknown subcommand '#{subcommand}'"
  warn "Run 'claire --help' for usage."
  exit 1
end
