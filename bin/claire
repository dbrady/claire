#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "optimist"
require "claire"

SUBCOMMANDS = %w[init doctor check log report edit alias approve].freeze

global_opts = Optimist.options do
  banner <<~BANNER
    claire - Clarity time tracker CLI

    Usage:
      claire <subcommand> [options]

    Subcommands:
      init    Bootstrap or heal config from ~/.claude/.mcp.json (idempotent)
      doctor  Check and heal local state (alias of init; run anytime)
      check   Resolve a ticket/PR/code and print the project code
      log     Resolve and record a billable time entry
      report  Show weekly hours by project code
      edit    Open the time log in $EDITOR
      alias   Manage project-code aliases (add/list/rm)
      approve Manage manual Clarity approval records (add/list/rm)

    Options:
  BANNER
  opt :version, "Print version and exit", short: :none
  stop_on SUBCOMMANDS
end

if global_opts[:version]
  puts "claire #{Claire::VERSION}"
  exit 0
end

subcommand = ARGV.shift

case subcommand
when "init"
  Optimist.options do
    banner <<~BANNER
      Usage: claire init

      Bootstrap or heal claire's local state. Idempotent — safe to run anytime.

      On a fresh machine: reads ~/.claude/.mcp.json for Atlassian credentials,
      writes ~/.config/claire/config.yml, creates the data dir, seeds starter
      files for aliases/project_names/approvals, and confirms JIRA auth.

      On a configured machine: re-validates the existing config, strips any
      stale phantom keys, seeds missing starter files, and confirms JIRA auth.
      Does not re-fetch from MCP — local config stays canonical.

      See also: claire doctor (same behavior, different verb).
    BANNER
  end
  require "claire/cli/init"
  Claire::CLI::Init.new.run
when "doctor"
  Optimist.options do
    banner <<~BANNER
      Usage: claire doctor

      Check and heal claire's local state. Idempotent — safe to run anytime.

      Equivalent to `claire init`: both verbs run the same heal sequence.
      Use whichever matches your mental model. `doctor` is the verb for
      routine maintenance ("is everything OK?"); `init` is the verb for
      first-time setup ("get me running").
    BANNER
  end
  require "claire/cli/doctor"
  Claire::CLI::Doctor.new.run
when "check"
  require "claire/cli/check"
  subopts = Optimist.options do
    opt :refresh, "Bypass cache, re-resolve, and rewrite cached entries", short: "-r", default: false
  end
  input = ARGV.shift
  if input.nil? || input.empty?
    warn "Usage: claire check [--refresh] <ticket|url|project-code>"
    exit 1
  end
  Claire::CLI::Check.new.run(input, refresh: subopts[:refresh])
when "log"
  require "claire/cli/log"
  subopts = Optimist.options do
    banner <<~BANNER
      Usage: claire log <target> <duration> [--on <date>] [--note <text>]

      Log time worked against a Clarity project. The target can be anything
      claire knows how to resolve to a project code; the duration uses a small
      grammar; --on accepts several friendly date forms.

      Targets:
        17347                                              PR number
        https://github.com/acima-credit/merchant_portal/pull/17347
                                                           PR URL
        MP-830                                             JIRA ticket
        https://upbd.atlassian.net/browse/MP-830           JIRA URL
        PR00673                                            project code (direct)

      Durations (bare numbers are hours; only the 'm' suffix opts in to minutes):
        2        2 hours
        2.0      2 hours
        2h       2 hours
        120m     2 hours
        1:30     1 hour 30 minutes
        45m      45 minutes
        (so 2 = 2h = 120m = 2.0 — all equivalent)

      Dates for --on (default: today):
        --on today
        --on yesterday
        --on wed                 most recent Wednesday (today counts)
        --on 5/13                M/D in the current year
        --on 2026-05-13          ISO date

      Examples:
        claire log 17347 2h
        claire log MP-830 1.5 --on yesterday --note "code review"
        claire log PR00673 90m --on 5/13
        claire log https://github.com/acima-credit/merchant_portal/pull/17347 2 --on wed

      Options:
    BANNER
    opt :on,      "Date worked on (YYYY-MM-DD, today, yesterday, weekday, M/D)", type: :string, short: "-O"
    opt :note,    "Free-text note", type: :string, short: "-m"
    opt :refresh, "Bypass resolver cache", short: "-r", default: false
  end
  target = ARGV.shift
  duration = ARGV.shift
  if target.nil? || target.empty? || duration.nil? || duration.empty?
    warn "Usage: claire log <target> <duration> [--on DATE] [--note STR]"
    exit 1
  end
  Claire::CLI::Log.new.run(target, duration, on: subopts[:on], note: subopts[:note], refresh: subopts[:refresh])
when "report"
  require "claire/cli/report"
  require "claire/dates"
  subopts = Optimist.options do
    opt :week,  "Sun-Sat week containing this date (YYYY-MM-DD)", type: :string, short: :none
    opt :start, "Range start date (YYYY-MM-DD)", type: :string, short: "-s"
    opt :end,   "Range end date (YYYY-MM-DD)", type: :string, short: "-e"
    opt :date,  "Sun-Sat week containing this date expression ('last week', '2 weeks ago', YYYY-MM-DD, M/D, today)", type: :string, short: "-d"
    opt :names, "Include project names in row labels (default: bare codes)", short: "-n", default: false
  end
  positional = ARGV.shift

  def parse_iso(str)
    Date.iso8601(str)
  rescue Date::Error, ArgumentError
    warn "claire report: invalid date '#{str}' — expected YYYY-MM-DD"
    exit 1
  end

  present = []
  present << :last  if positional == "last"
  present << :week  if subopts[:week]
  present << :start if subopts[:start]
  present << :end   if subopts[:end]
  present << :date  if subopts[:date]

  cli = Claire::CLI::Report.new
  names = subopts[:names]
  case present
  when []
    cli.run(mode: :this_week, names: names)
  when [:last]
    cli.run(mode: :last_week, names: names)
  when [:week]
    cli.run(mode: :specific_week, week: parse_iso(subopts[:week]), names: names)
  when [:date]
    begin
      sunday, saturday = Claire::Dates.expand_to_week(subopts[:date])
    rescue ArgumentError => e
      warn "claire report: #{e.message}"; exit 1
    end
    cli.run(mode: :range, start_date: sunday, end_date: saturday, names: names)
  when [:start, :end]
    cli.run(mode: :range,
            start_date: parse_iso(subopts[:start]),
            end_date:   parse_iso(subopts[:end]),
            names: names)
  when [:start]
    warn "claire report: --start requires --end"; exit 1
  when [:end]
    warn "claire report: --end requires --start"; exit 1
  else
    if present.include?(:date)
      warn "claire report: --date cannot be combined with --start/--end, --week, or 'last'"; exit 1
    else
      warn "claire report: cannot mix `last`, --week, and --start/--end"; exit 1
    end
  end
when "edit"
  require "claire/cli/edit"
  Optimist.options # no flags; consume any stray args cleanly
  Claire::CLI::Edit.new.run
when "alias"
  Optimist.options do
    banner <<~BANNER
      Usage: claire alias <add|list|rm> [args...]

      Manage project-code aliases — short mnemonics that resolve to project
      codes. Case-insensitive: `claire alias add OOO PR00425` and
      `claire log ooo 4` both refer to PR00425.

      Subcommands:
        add <name> <code>   Add or overwrite an alias.
        list                List all aliases.
        rm <name>           Remove an alias.

      Examples:
        claire alias add BF PR00673
        claire alias list
        claire alias rm BF
    BANNER
    stop_on %w[add list rm]
  end
  require "claire/cli/alias"
  Claire::CLI::Alias.new.run(ARGV)
when "approve"
  Optimist.options do
    banner <<~BANNER
      Usage: claire approve <add|list|rm> [args...]

      Manage manual Clarity approval records. Clarity grants approval at the
      epic level, so approvals are keyed by the JIRA key of the epic (e.g.
      MP-445), not by project code.

      Subcommands:
        add <epic-key>      Record approval for a JIRA epic key (timestamps now).
        list                List all approval records.
        rm <epic-key>       Remove an approval record.

      Examples:
        claire approve add MP-445
        claire approve list
        claire approve rm MP-445
    BANNER
    stop_on %w[add list rm]
  end
  require "claire/cli/approve"
  Claire::CLI::Approve.new.run(ARGV)
when nil
  Optimist.educate
else
  warn "claire: unknown subcommand '#{subcommand}'"
  warn "Run 'claire --help' for usage."
  exit 1
end
